{
    "name": "lifelog-app",
    "main": "expo-router/entry",
    "version": "0.0.0",
    "scripts": {
        "start": "expo start --dev-client",
        "dev": "expo start",
        "dev:clear": "expo start -c",
        "android": "expo run:android",
        "lint": "eslint --fix src --ext .js,.jsx,.ts,.tsx",
        "format": "prettier --write .",
        "format:check": "prettier . --check",
        "prepare": "husky",
        "build:dev": "eas build --profile development --platform android",
        "build:preview": "eas build --profile preview --platform android"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "**/*.{md,json,yml,css,html}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@expo/ui": "~56.0.19",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-native-fontawesome": "^1.0.0",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@reduxjs/toolkit": "^2.12.0",
        "@tanstack/react-query": "^5.101.4",
        "expo": "~56.0.13",
        "expo-constants": "~56.0.18",
        "expo-dev-client": "~56.0.24",
        "expo-device": "~56.0.4",
        "expo-file-system": "~56.0.8",
        "expo-font": "~56.0.7",
        "expo-glass-effect": "~56.0.4",
        "expo-image": "~56.0.11",
        "expo-linking": "~56.0.14",
        "expo-router": "~56.2.12",
        "expo-splash-screen": "~56.0.14",
        "expo-sqlite": "^57.0.1",
        "expo-status-bar": "~56.0.4",
        "expo-symbols": "~56.0.6",
        "expo-system-ui": "~56.0.5",
        "expo-web-browser": "~56.0.5",
        "nativewind": "^4.2.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.85.3",
        "react-native-fast-opencv": "^1.0.0",
        "react-native-gesture-handler": "~2.31.1",
        "react-native-reanimated": "4.3.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "4.25.2",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.8.3",
        "react-redux": "^9.3.0"
    },
    "devDependencies": {
        "@types/react": "~19.2.2",
        "eslint": "^9.39.4",
        "eslint-config-expo": "~56.0.4",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.4",
        "tailwindcss": "^3.4.19",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.62.1"
    },
    "private": true
}
