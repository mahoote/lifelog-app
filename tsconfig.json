{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"]
        },
        "typeRoots": ["./node_modules/@types"],
        "resolveJsonModule": true
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "app.config.js",
        "nativewind-env.d.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
